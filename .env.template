# Expo Configuration (for building)
EXPO_TOKEN=your-expo-token-here

# Build Configuration
ANDROID_PACKAGE_NAME=com.afaryab.atoffice
IOS_BUNDLE_IDENTIFIER=com.afaryab.atoffice
